{
  "name": "tecverde-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "db:generate": "bunx --no-install drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:studio": "bunx --no-install drizzle-kit studio",
    "db:seed": "bun scripts/seed.ts",
    "db:reset:local": "bun scripts/db-reset-local.ts",
    "vercel-build": "bun run db:migrate && bun run build",
    "staff:bootstrap": "bun scripts/staff-bootstrap.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@libsql/client": "0.18.0",
    "@marsidev/react-turnstile": "1.6.3",
    "@t3-oss/env-nextjs": "0.13.11",
    "@upstash/redis": "1.41.0",
    "better-auth": "1.7.26",
    "drizzle-orm": "1.0.0-rc.5",
    "geist": "1.9.2",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
