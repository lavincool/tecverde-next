{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".next/", "drizzle/", "next-env.d.ts", "bun.lock"],
  "sortImports": {
    "internalPattern": ["@/"],
    "groups": [
      "side_effect",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "type",
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn"]
  }
}
