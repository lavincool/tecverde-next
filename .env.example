# Optional canonical origin. Set this to the HTTPS custom domain at launch.
# Until then, leave it empty in preview and use the local origin for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Start the local Turso HTTP server before migrating or seeding.
TURSO_DATABASE_URL=http://127.0.0.1:3180
# Add the database-specific token when connecting to hosted Turso.
TURSO_AUTH_TOKEN=

# Generate independent random secrets of at least 32 characters for each value.
BETTER_AUTH_SECRET=
HASH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional locally. Both are required for distributed staff rate limits on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Turnstile. Leave both empty locally to skip the challenge.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# Production fails closed when the secret is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Kill switch for anonymous reports, confirmations, pet posts and adoption requests.
PUBLIC_SUBMISSIONS_ENABLED=true

# Email. Defaults to logging messages to the console outside production.
# Set EMAIL_TRANSPORT=memory only for automated tests.
EMAIL_TRANSPORT=
RESEND_API_KEY=
EMAIL_FROM="TecVerde <avisos@example.com>"
